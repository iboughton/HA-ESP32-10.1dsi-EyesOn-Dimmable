aside.actions-panel {
  position: sticky;
  top: 18px;
}

aside.actions-panel section {
  margin-top: 0;
}

.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: grid;
  place-items: center;
  padding: 18px;
  background: rgba(3, 8, 13, 0.72);
}

#lightEntityPickerOverlay {
  z-index: 1020;
}

.modal-card {
  width: min(560px, 100%);
  max-height: min(720px, calc(100vh - 36px));
  overflow: auto;
  background: #102233;
  border: 1px solid #38556f;
  border-radius: 8px;
  padding: 14px;
  box-shadow: 0 18px 44px rgba(0, 0, 0, 0.42);
}

.light-picker-dialog {
  display: grid;
  gap: 10px;
}

.setup-wizard-overlay {
  z-index: 1010;
}

.setup-wizard-dialog {
  display: grid;
  gap: 12px;
  width: min(620px, 100%);
}

.setup-wizard-steps {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6px;
}

.setup-wizard-step {
  min-width: 0;
  border: 1px solid #2f4960;
  border-radius: 8px;
  background: #132433;
  color: var(--muted);
  padding: 7px 8px;
  font-size: 11px;
  font-weight: 700;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.setup-wizard-step.done {
  border-color: #347965;
  color: #a7f4d8;
}

.setup-wizard-step.active {
  border-color: var(--accent);
  color: var(--text);
  box-shadow: 0 0 0 1px var(--accent) inset;
}

.setup-wizard-actions-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.setup-widget-btn {
  min-height: 42px;
  text-align: left;
}

.setup-wizard-count {
  border: 1px solid #2f4960;
  border-radius: 8px;
  background: #132433;
  color: #c8d7e7;
  padding: 9px 10px;
  font-size: 12px;
  font-weight: 700;
}

.setup-wizard-footer {
  justify-content: flex-end;
}

.light-picker-search {
  width: 100%;
}

.entity-picker-progress {
  display: grid;
  gap: 5px;
}

.entity-picker-progress.hidden {
  display: none;
}

.entity-picker-progress-track {
  width: 100%;
  height: 7px;
  overflow: hidden;
  border: 1px solid #355168;
  border-radius: 999px;
  background: #0a1723;
}

.entity-picker-progress-bar {
  width: 0%;
  height: 100%;
  background: #6fe8ff;
  transition: width 180ms ease;
}

.light-picker-rooms {
  display: grid;
  gap: 8px;
}

.light-picker-room {
  border: 1px solid #2f4960;
  border-radius: 8px;
  background: #132433;
  overflow: hidden;
}

.light-picker-room summary {
  cursor: pointer;
  padding: 9px 10px;
  font-size: 13px;
  font-weight: 700;
  color: var(--text);
}

.light-picker-room-list {
  display: grid;
  gap: 6px;
  padding: 0 10px 10px;
}

.light-picker-entity {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 6px;
  align-items: center;
  width: 100%;
  border: 1px solid #355168;
  border-radius: 8px;
  background: #172b3e;
  color: var(--text);
  padding: 8px;
  cursor: pointer;
  text-align: left;
}

.light-picker-entity strong,
.light-picker-entity span {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.light-picker-entity span {
  color: var(--muted);
  font-size: 11px;
}

@media (max-width: 1100px) {
  .shell {
    grid-template-columns: 1fr;
  }
  .workspace {
    padding-top: 0;
  }
  .workspace-body {
    grid-template-columns: 1fr;
  }
  aside.actions-panel {
    position: static;
  }
}

@media (max-width: 560px) {
  .setup-wizard-steps,
  .setup-wizard-actions-grid {
    grid-template-columns: 1fr;
  }

  .setup-wizard-footer {
    justify-content: stretch;
  }

  .setup-wizard-footer .btn {
    flex: 1 1 100%;
  }
}


/* Theme editor */
.theme-color-grid {
  display: flex;
  flex-direction: column;
  gap: 6px;
  max-height: 360px;
  overflow-y: auto;
  padding: 4px;
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 6px;
}
.theme-color-group {
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 6px;
  background: rgba(255,255,255,0.02);
}
.theme-color-group > summary {
  list-style: none;
  cursor: pointer;
  padding: 6px 10px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--muted);
  user-select: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.theme-color-group > summary::-webkit-details-marker { display: none; }
.theme-color-group > summary::after {
  content: "-";
  color: var(--muted);
  font-weight: 700;
}
.theme-color-group:not([open]) > summary::after { content: "+"; }
.theme-color-group-body {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 6px;
  padding: 6px 10px 10px;
}
.theme-color-group-body label {
  display: flex;
  flex-direction: column;
  font-size: 11px;
  gap: 2px;
}
.theme-color-group-body input[type="color"] {
  width: 100%;
  height: 26px;
  padding: 0;
  border: none;
  background: transparent;
  cursor: pointer;
}
.theme-preview-wrap {
  margin-top: 6px;
}
.theme-preview-wrap canvas {
  width: 100%;
  max-width: 360px;
  height: auto;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8px;
  display: block;
}

/* =========================================================
 * Simplified Layout UI: dropdowns, inline row actions,
 * inspector groups. Keep legacy buttons hidden.
 * ========================================================= */
.legacy-hidden {
  display: none !important;
}

/* Generic dropdown used for Add Page / Add Widget menus. */
.dropdown {
  position: relative;
  display: inline-flex;
}
.dropdown-toggle {
  white-space: nowrap;
}
.dropdown-menu {
  position: absolute;
  top: 100%;
  right: 0;
  z-index: 40;
  min-width: 180px;
  margin-top: 4px;
  padding: 6px;
  background: var(--panel-2);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.5);
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.dropdown-menu.hidden {
  display: none;
}
.dropdown-group {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding-bottom: 4px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  margin-bottom: 4px;
}
.dropdown-group:last-child {
  border-bottom: none;
  padding-bottom: 0;
  margin-bottom: 0;
}
.dropdown-group-label {
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  padding: 4px 6px 2px;
}
.dropdown-item {
  appearance: none;
  background: transparent;
  color: var(--text);
  border: none;
  text-align: left;
  padding: 7px 10px;
  border-radius: 6px;
  font-size: 13px;
  cursor: pointer;
}
.dropdown-item:hover,
.dropdown-item:focus-visible {
  background: rgba(255,255,255,0.08);
  outline: none;
}

/* Inline row actions (used by pages list + widgets list) */
.list li .row-actions {
  display: inline-flex;
  gap: 4px;
  margin-left: auto;
  opacity: 0.75;
}
.list li:hover .row-actions,
.list li.selected .row-actions {
  opacity: 1;
}
.row-icon-btn {
  appearance: none;
  background: transparent;
  border: 1px solid transparent;
  color: var(--muted);
  padding: 2px 6px;
  border-radius: 5px;
  cursor: pointer;
  font-size: 12px;
  line-height: 1;
}
.row-icon-btn:hover {
  color: var(--text);
  background: rgba(255,255,255,0.08);
}
.row-icon-btn.danger:hover {
  color: #fff;
  background: var(--danger);
}
/* Right-aligned delete button: white X on a red circle. */
.row-delete-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--danger, #d23b3b);
  color: #fff;
  font-size: 13px;
  line-height: 1;
  font-weight: 700;
  cursor: pointer;
}
.row-delete-btn:hover {
  background: #ff4d4d;
  color: #fff;
}
.row-rename-input {
  flex: 1;
  min-width: 0;
  background: rgba(0,0,0,0.25);
  color: var(--text);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 4px;
  padding: 2px 6px;
  font-size: 13px;
}

/* Inspector sub-groups */
.inspector-group {
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 8px;
  margin-bottom: 8px;
  background: rgba(255,255,255,0.02);
}
.inspector-group > summary {
  list-style: none;
  cursor: pointer;
  padding: 7px 10px;
  font-weight: 600;
  font-size: 12px;
  letter-spacing: 0.04em;
  color: var(--text);
  user-select: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.inspector-group > summary::-webkit-details-marker {
  display: none;
}
.inspector-group > summary::after {
  content: "-";
  color: var(--muted);
  font-weight: 700;
}
.inspector-group:not([open]) > summary::after {
  content: "+";
}
.inspector-group-body {
  padding: 6px 10px 10px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
