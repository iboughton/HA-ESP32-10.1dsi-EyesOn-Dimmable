  color: #039bef;
}

.energy-preview-node.home {
  left: 528px;
  top: 346px;
  width: 116px;
  height: 116px;
  margin: -58px 0 0 -58px;
  border: 0;
  background:
    radial-gradient(circle, #1d1f24 0, #1d1f24 calc(50% - 4px), transparent calc(50% - 3px), transparent 100%),
    conic-gradient(var(--energy-home-ring, #435566 0deg 360deg));
}

.energy-preview-node.battery {
  left: 312px;
  top: 506px;
  border-color: #e84393;
  color: #e84393;
}

.energy-preview-node.water {
  left: 528px;
  top: 506px;
  border-color: #00bcd4;
  color: #00bcd4;
}

.energy-preview-label {
  position: absolute;
  z-index: 3;
  width: 180px;
  margin-left: -90px;
  text-align: center;
  color: var(--muted);
  font-size: 14px;
}

.energy-preview-label strong,
.energy-preview-label small {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.energy-preview-label strong {
  color: #cdd7e1;
  font-weight: 500;
}

.energy-preview-label small {
  margin-top: 4px;
  color: #8ea1b5;
  font-size: 11px;
}

.energy-preview-label.low-carbon {
  left: 96px;
  top: 64px;
}

.energy-preview-label.solar {
  left: 312px;
  top: 64px;
}

.energy-preview-label.gas {
  left: 528px;
  top: 64px;
}

.energy-preview-label.grid {
  left: 96px;
  top: 408px;
}

.energy-preview-label.home {
  left: 528px;
  top: 416px;
}

.energy-preview-label.battery {
  left: 312px;
  top: 566px;
}

.energy-preview-label.water {
  left: 528px;
  top: 566px;
}

.energy-page-preview.compact .energy-preview-heading {
  display: none;
}

.energy-page-preview.compact .energy-preview-flow path.flow {
  stroke-width: 2px;
}

.energy-page-preview.compact .energy-preview-node {
  width: 86px;
  height: 86px;
  margin: -43px 0 0 -43px;
  border-width: 2px;
  gap: 4px;
  font-size: 11px;
}

.energy-page-preview.compact .energy-preview-node strong {
  font-size: 13px;
}

.energy-page-preview.compact .energy-preview-node span {
  font-size: 12px;
}

.energy-page-preview.compact .energy-preview-node.low-carbon {
  left: 76px;
