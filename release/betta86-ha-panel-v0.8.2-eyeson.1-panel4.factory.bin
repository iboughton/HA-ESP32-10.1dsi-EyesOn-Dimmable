}

.energy-page-preview.compact .energy-preview-node.solar {
  left: 240px;
  top: 82px;
}

.energy-page-preview.compact .energy-preview-node.gas {
  left: 404px;
  top: 82px;
}

.energy-page-preview.compact .energy-preview-node.grid {
  left: 76px;
  top: 205px;
}

